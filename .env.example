# Banco: Postgres compartilhado do DB-DOCKER (db-postgres), database "kb"
DATABASE_URL=postgresql://user:password@localhost:5432/kb

# Embeddings: voyage | openai | local | fake
#   voyage -> precisa VOYAGE_API_KEY (modelo padrão voyage-3.5, 1024 dims)
#   openai -> precisa OPENAI_API_KEY (text-embedding-3-small reduzido para 1024 dims)
#   local  -> instala extra "local" (sentence-transformers, BAAI/bge-m3, 1024 dims, roda na máquina)
#   fake   -> só para testes/dev: vetores determinísticos SEM semântica
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Chunking (em palavras)
CHUNK_WORDS=450
CHUNK_OVERLAP_WORDS=60

# Detecção de duplicatas (similaridade de cosseno 0..1)
DUPLICATE_THRESHOLD=0.92
MEMORY_DUPLICATE_THRESHOLD=0.90

# load_agent: quantas memórias entram no contexto inicial
LOAD_AGENT_MEMORY_LIMIT=15

# Autenticação: chave única do servidor. Todo acesso (REST e MCP, HTTP e stdio) exige
#   Authorization: Bearer <KB_API_KEY>, exceto /health. Gere uma forte, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Em dev você pode ligar KB_AUTH_DISABLED=true para não precisar do header.
KB_API_KEY=
KB_AUTH_DISABLED=false

# Logging do servidor: DEBUG | INFO | WARNING | ERROR | CRITICAL (padrão INFO)
KB_LOG_LEVEL=INFO

# Chave read-only (opcional): autentica como um Principal com escopo apenas "read".
# Ideal para integrações que só consultam a base. Deixe vazio para desativar.
KB_READ_ONLY_KEY=

# Documentação interativa (/docs e /openapi.json): desligada por padrão em produção.
# KB_DOCS_ENABLED=true reativa em dev (a doc revela a superfície inteira da API).
KB_DOCS_ENABLED=false

# Limite de payload HTTP (bytes). Requests com Content-Length acima disso recebem 413.
KB_MAX_BODY_BYTES=2097152
